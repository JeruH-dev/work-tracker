generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  emailVerified     Boolean             @default(false)
  createdAt          DateTime            @default(now())
  activities         Activity[]
  projects           Project[]
  tasks              Task[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

model Project {
  id          String        @id @default(cuid())
  projectRef  String        @unique
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  workstream  Workstream
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation(fields: [ownerId], references: [id])
  tasks       Task[]

  @@index([status])
  @@index([workstream])
}

model Task {
  id          String     @id @default(cuid())
  taskRef     String     @unique
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(BACKLOG)
  dueDate     DateTime?
  outcome     String?
  nextAction  String?
  blocker     String?
  projectId   String?
  assigneeId  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  activities  Activity[]
  assignee    User       @relation(fields: [assigneeId], references: [id])
  project     Project?   @relation(fields: [projectId], references: [id])

  @@index([status])
  @@index([dueDate])
  @@index([projectId])
}

model Activity {
  id         String   @id @default(cuid())
  note       String
  occurredAt DateTime @default(now())
  taskId     String?
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  task       Task?    @relation(fields: [taskId], references: [id])

  @@index([occurredAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum Workstream {
  PROGRAMME_SUPPORT
  OPERATIONS
  REPORTING
  PARTNERSHIPS
  PROFESSIONAL_DEVELOPMENT
  OTHER
}
