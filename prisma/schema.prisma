generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum Workstream {
  PROGRAMME_SUPPORT
  OPERATIONS
  REPORTING
  PARTNERSHIPS
  PROFESSIONAL_DEVELOPMENT
  OTHER
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  projects     Project[]
  tasks        Task[]
  activities Activity[]
}

model Project {
  id          String        @id @default(cuid())
  projectRef  String        @unique
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  workstream  Workstream
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id])
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([workstream])
}

model Task {
  id           String     @id @default(cuid())
  taskRef      String     @unique
  title        String
  description  String?
  priority     Priority   @default(MEDIUM)
  status       TaskStatus @default(BACKLOG)
  dueDate      DateTime?
  outcome      String?
  nextAction   String?
  blocker      String?
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id])
  assigneeId   String
  assignee     User       @relation(fields: [assigneeId], references: [id])
  activities   Activity[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([projectId])
}

model Activity {
  id          String   @id @default(cuid())
  note        String
  occurredAt  DateTime @default(now())
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  @@index([occurredAt])
}
